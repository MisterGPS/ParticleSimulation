{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 1
    },
    "configurePresets": [
        {
            "name": "windows-only",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "arm64-target",
            "hidden": true,
            "description": "Using compilers for Visual Studio 18 2026 (arm64 architecture)",
            "generator": "Visual Studio 18 2026",
            "toolset": {
                "value": "host=ARM64,version=14.52",
                "strategy": "external"
            },
            "architecture": "arm64"
        },
        {
            "name": "x64-target",
            "hidden": true,
            "description": "Using compilers for Visual Studio 18 2026 (x64 architecture)",
            "generator": "Visual Studio 18 2026",
            "toolset": {
                "value": "host=x64,version=14.52",
                "strategy": "external"
            },
            "architecture": "x64"
        },
        {
            "name": "Debug - arm64",
            "displayName": "Visual Studio Community 2026 Debug - arm64",
            "description": "Using compilers for Visual Studio 18 2026 (arm64 architecture)",
            "inherits": ["windows-only", "arm64-target"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release - arm64",
            "displayName": "Visual Studio Community 2026 Release - arm64",
            "description": "Using compilers for Visual Studio 18 2026 (arm64 architecture)",
            "inherits": ["windows-only", "arm64-target"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "MinRelSize - arm64",
            "displayName": "Visual Studio Community 2026 MinRelSize - arm64",
            "description": "Using compilers for Visual Studio 18 2026 (arm64 architecture)",
            "inherits": ["windows-only", "arm64-target"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "RelWithDebInfo - arm64",
            "displayName": "Visual Studio Community 2026 RelWithDebInfo - arm64",
            "description": "Using compilers for Visual Studio 18 2026 (arm64 architecture)",
            "inherits": ["windows-only", "arm64-target"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release - Benchmark",
            "displayName": "Visual Studio Community 2026 Release - Benchmark (arm64)",
            "description": "Release build with fixed 60fps timestep that exits after a set number of steps",
            "inherits": ["Release - arm64"],
            "cacheVariables": {
                "BENCHMARK": "ON"
            }
        },
        {
            "name": "Debug - Benchmark",
            "displayName": "Visual Studio Community 2026 Debug - Benchmark (arm64)",
            "description": "Debug build with fixed 60fps timestep that exits after a set number of steps",
            "inherits": ["Debug - arm64"],
            "cacheVariables": {
                "BENCHMARK": "ON"
            }
        },
        {
            "name": "Debug - x64",
            "displayName": "Visual Studio Community 2026 Debug - x64",
            "description": "Using compilers for Visual Studio 18 2026 (x64 architecture)",
            "inherits": ["windows-only", "x64-target"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release - x64",
            "displayName": "Visual Studio Community 2026 Release - x64",
