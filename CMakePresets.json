            "inherits": ["windows-only", "x64-target"],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Release - arm64",
            "displayName": "VS 2026 Release - arm64",
            "configurePreset": "Release - arm64",
            "configuration": "Release"
        },
        {
